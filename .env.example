# ==============================================================================
# Workspace v1 — Environment Configuration Template (.env.example)
# Note: Use placeholder values only. Never commit production secrets.
# ==============================================================================

# Core Runtime Configuration
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=info
REDACT_SENSITIVE_LOGS=true

# Architecture Selection ('architecture_a' for PaaS / 'architecture_b' for AWS Prod)
ARCHITECTURE_TIER=architecture_a

# Database Configuration — three roles (ADR 17b). The dev passwords below exist only in the local docker
# database (infra/docker/postgres/init.sql); deployed environments take them from the secret store.
# API/BFF runtime login (non-superuser, no BYPASSRLS): transaction pooler mode (e.g., Supabase pooler port 6543 or RDS Proxy)
DATABASE_URL=postgresql://workspace_api:workspace_api_dev_password@localhost:5432/workspace_dev?sslmode=disable
# Worker runtime login and pg-boss: direct session mode (required for pg-boss advisory locks)
DATABASE_DIRECT_URL=postgresql://workspace_worker:workspace_worker_dev_password@localhost:5432/workspace_dev?sslmode=disable
# Migrations only: the database owner (never used by a running service)
DATABASE_MIGRATION_URL=postgresql://workspace_user:workspace_dev_password@localhost:5432/workspace_dev?sslmode=disable
DB_API_POOL_SIZE=10
DB_WORKER_POOL_SIZE=5

# API Server Settings (Fastify)
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
# Header secret for origin verification (X-Origin-Verify) between CloudFront and ALB/API
ORIGIN_VERIFY_SECRET=replace-with-32-char-min-origin-verification-secret

# Background Worker Settings
WORKER_PORT=8081
WORKER_CONCURRENCY=5

# Web Application Settings (Next.js)
WEB_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Port Provider Selection
# Queue: 'pgboss' (Architecture A) | 'sqs' (Architecture B)
QUEUE_PROVIDER=pgboss
# Realtime: 'supabase' (Architecture A) | 'appsync' (Architecture B)
REALTIME_PROVIDER=supabase
# LLM: 'anthropic' (Architecture A) | 'bedrock' (Architecture B)
LLM_PROVIDER=anthropic
# BlobStore: 'supabase' (Architecture A) | 's3' (Architecture B)
STORAGE_PROVIDER=supabase
# Auth: 'supabase' (Architecture A) | 'cognito' (Architecture B)
AUTH_PROVIDER=supabase

# Architecture A Provider Placeholders (PaaS / Design-Partner Beta)
SUPABASE_URL=https://placeholder-project-ref.supabase.co
SUPABASE_ANON_KEY=placeholder-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-supabase-service-role-key
ANTHROPIC_API_KEY=placeholder-anthropic-api-key

# Architecture B Provider Placeholders (AWS-only Production)
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=placeholder-ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=placeholder-cognito-client-id
SQS_MEETING_EVENTS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/workspace-meeting-events
S3_ATTACHMENTS_BUCKET=workspace-v1-attachments-ap-south-1
BEDROCK_INDIA_INFERENCE_PROFILE_ARN=arn:aws:bedrock:ap-south-1:123456789012:inference-profile/in.anthropic.claude-v1
